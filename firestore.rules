rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Catch-all: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint for User profile
    function isValidUser(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.subscriptionTier in ['free', 'pro', 'premium'] &&
             data.usageCount is int &&
             data.usageCount >= 0;
    }

    // Validation Blueprint for Real-Time Tool Execution
    function isValidExecution(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.toolId is string &&
             data.toolId.size() <= 64 &&
             data.toolName is string &&
             data.toolName.size() <= 128 &&
             data.input is string &&
             data.input.size() <= 15000 &&
             data.result is string &&
             data.result.size() <= 65000;
    }

    // User Records
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['usageCount']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['subscriptionTier']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['usageCount', 'lastUsageReset']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['usageCount', 'updatedAt'])
      );

      // Real-Time Tool Executions Subcollection
      match /executions/{executionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidExecution(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
